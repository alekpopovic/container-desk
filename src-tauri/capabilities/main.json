{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Permit narrow application and read-session commands only from the local main window.",
  "windows": ["main"],
  "permissions": [
    "allow-app-version",
    "allow-get-activity",
    "allow-set-management",
    "allow-get-management",
    "allow-cancel-mutation",
    "allow-prepare-confirmation",
    "allow-mutate-container",
    "allow-list-hosts",
    "allow-connect-host",
    "allow-list-containers",
    "allow-verify-compose-project",
    "allow-mutate-compose-project",
    "allow-list-compose",
    "allow-list-images",
    "allow-list-volumes",
    "allow-list-networks",
    "allow-inspect-volume",
    "allow-inspect-network",
    "allow-inspect-image",
    "allow-cancel-subscription",
    "allow-get-preferences",
    "allow-set-theme",
    "allow-dependency-diagnostics",
    "allow-set-ssh-executable",
    "allow-inspect-container",
    "allow-container-logs",
    "allow-container-stats",
    "allow-follow-container-logs",
    "allow-follow-docker-events",
    "allow-ack-docker-events",
    "allow-ack-container-logs",
    "allow-export-container-logs",
    "allow-get-workspace-mode",
    "allow-switch-workspace",
    "allow-get-ssh-config-path",
    "allow-discover-ssh-hosts",
    "allow-select-ssh-alias",
    "allow-resolve-ssh-config",
    "allow-check-ssh-access",
    "allow-begin-ssh-session",
    "allow-get-ssh-session",
    "allow-disconnect-ssh-session",
    "allow-get-host-inventory",
    "allow-save-host",
    "allow-remove-host",
    "allow-connect-inventory-host",
    "allow-disconnect-inventory-host"
  ]
}
